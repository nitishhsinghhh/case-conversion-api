<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StringConversionAPI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.1" />
  </ItemGroup>

  <ItemGroup >
  <!-- Windows DLL -->
  <None Include="../CppLib/build_dll/Release/libProcessStringDLL.dll"
        CopyToOutputDirectory="Always"
        Condition=" '$(CI)' != 'true' AND '$(OS)' == 'Windows_NT' " />

  <!-- macOS DLL -->
  <None Include="../CppLib/build_dll/lib/libProcessStringDLL.dylib"
        CopyToOutputDirectory="Always"
        Condition=" '$(CI)' != 'true' AND  '$(OS)' == 'OSX' " />

  <!-- Linux DLL -->
  <None Include="../CppLib/build_dll/lib/libProcessStringDLL.so"
        CopyToOutputDirectory="Always"
        Condition=" '$(CI)' != 'true' AND '$(OS)' == 'Linux' " />
</ItemGroup>

<ItemGroup>
  <PackageReference Include="OpenTelemetry" Version="1.15.3" />
  <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
  <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
  <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
  <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
</ItemGroup>

</Project>