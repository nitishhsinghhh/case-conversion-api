<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StringConversionAPI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.1" />
  </ItemGroup>

  <ItemGroup >
  <!-- Windows DLL -->
  <None Include="../CppLib/build_dll/Release/libProcessStringDLL.dll"
        CopyToOutputDirectory="Always"
        Condition=" '$(CI)' != 'true' AND '$(OS)' == 'Windows_NT' " />

  <!-- macOS DLL -->
  <None Include="../CppLib/build_dll/lib/libProcessStringDLL.dylib"
        CopyToOutputDirectory="Always"
        Condition=" '$(CI)' != 'true' AND  '$(OS)' == 'OSX' " />

  <!-- Linux DLL -->
  <None Include="../CppLib/build_dll/lib/libProcessStringDLL.so"
        CopyToOutputDirectory="Always"
        Condition=" '$(CI)' != 'true' AND '$(OS)' == 'Linux' " />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Signal over Noise: Suppress specific warnings we have already audited -->
    <!-- NU1902: OpenTelemetry Vulnerability (Audited) -->
    <!-- CS8625: Null literal to non-nullable (Handled via logic) -->
    <NoWarn>$(NoWarn);NU1902;CS8625</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
  <AnalysisLevel>latest</AnalysisLevel>
  <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  <!-- Force UTF-8 -->
  <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <PropertyGroup>
  <!-- Forces the compiler to use UTF-8 for all source files -->
  <OutputEncoding>UTF-8</OutputEncoding>
  <CodePage>65001</CodePage>
  </PropertyGroup>

</Project>