<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DotNetAPI\DotNetAPI.csproj" />
  </ItemGroup>

  <!-- Robust Native Library Inclusion -->
  <ItemGroup>
  <!-- Ensure the test project can also find the native library across platforms -->
  <Content Include="../../CppLib/build/**/ProcessStringDLL.dll;../../CppLib/build/**/libProcessStringDLL.dylib;../../CppLib/build/**/libProcessStringDLL.so">
    <Link>%(RecursiveDir)%(FileName)%(Extension)</Link>
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <Visible>false</Visible>
  </Content>
  </ItemGroup>

  <PropertyGroup>
    <!-- Signal over Noise: Suppress specific warnings we have already audited -->
    <!-- NU1902: OpenTelemetry Vulnerability (Audited) -->
    <!-- CS8625: Null literal to non-nullable (Handled via logic) -->
    <NoWarn>$(NoWarn);NU1902;CS8625</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
  <AnalysisLevel>latest</AnalysisLevel>
  <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  <!-- Force UTF-8 -->
  <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <PropertyGroup>
  <!-- Forces the compiler to use UTF-8 for all source files -->
  <OutputEncoding>UTF-8</OutputEncoding>
  <CodePage>65001</CodePage>
  </PropertyGroup>

</Project>